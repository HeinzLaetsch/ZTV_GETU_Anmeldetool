{
  "name": "at-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/at-app/src",
  "prefix": "app",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/at-app",
        "index": "apps/at-app/src/index.html",
        "browser": "apps/at-app/src/main.ts",
        "sourceMap": true,
        "polyfills": [
          "zone.js",
          "@angular/localize/init"
        ],
        "tsConfig": "apps/at-app/tsconfig.app.json",
        "aot": false,
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": [
            ".",
            "apps/at-app/src"
          ]
        },
        "assets": [
          "apps/at-app/src/favicon.ico",
          "apps/at-app/src/assets"
        ],
        "styles": [
          "apps/at-app/src/styles.scss"
        ],
        "allowedCommonJsDependencies": [
          "moment",
          "file-saver"
        ],
        "scripts": [
          "node_modules/jquery/dist/jquery.min.js"
        ]
      },
      "configurations": {
        "development": {
          "baseHref": "/ztv-anmeldetool/",
          "optimization": false,
          "sourceMap": {
            "scripts": true,
            "styles": true,
            "vendor": true
          },
          "extractLicenses": true,
          "allowedCommonJsDependencies": [
            "moment",
            "file-saver"
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "10mb",
              "maximumError": "15mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "250kb"
            }
          ]
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/at-app/src/environments/environment.ts",
              "with": "apps/at-app/src/environments/environment.prod.ts"
            }
          ],
          "baseHref": "/ztv-anmeldetool/",
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "aot": true,
          "extractLicenses": true,
          "allowedCommonJsDependencies": [
            "moment",
            "file-saver"
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "10mb",
              "maximumError": "15mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "250kb"
            }
          ]
        },
        "halle": {
          "fileReplacements": [
            {
              "replace": "apps/at-app/src/environments/environment.ts",
              "with": "apps/at-app/src/environments/environment.halle.ts"
            }
          ],
          "baseHref": "/",
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "aot": true,
          "extractLicenses": true,
          "allowedCommonJsDependencies": [
            "moment",
            "file-saver"
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3.2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "cache": false,
      "options": {
        "buildTarget": "at-app:build:development",
        "servePath": "/ztv-anmeldetool"
      },
      "configurations": {
        "development": {
          "buildTarget": "at-app:build:development"
        },
        "e2e": {
          "buildTarget": "at-app:build:development",
          "port": 4300,
          "host": "127.0.0.1"
        },
        "production": {
          "buildTarget": "at-app:build:production"
        },
        "halle": {
          "buildTarget": "at-app:build:halle"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "at-app:build"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "at-app:build:development",
        "tsConfig": "apps/at-app/tsconfig.spec.json",
        "runner": "vitest"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --config=e2e/playwright.config.ts"
      }
    },
    "playwright": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --config=e2e/playwright.config.ts"
      }
    }
  }
}
{
  "name": "anmeldetool-web-workspace",
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "ora": "5.3.0"
  },
  "scripts": {
    "ng": "ng",
    "start-nx": "nx serve at-app --live-reload --configuration=development --skip-nx-cache",
    "start-dev": "npm run start",
    "start-halle": "nx run at-app:serve:halle --live-reload",
    "startHalle": "npm run start-halle",
    "start": "npm run start",
    "build-dev-nx": "nx run at-app:build:development --skip-nx-cache",
    "build": "nx build",
    "build-halle": "nx run at-app:build:halle --skip-nx-cache",
    "build-halle-nx": "npm run build-halle",
    "test": "nx test",
    "lint": "eslint --config apps/at-app/eslint.config.js \"apps/at-app/src/**/*.{ts,html}\" \"e2e/**/*.ts\"",
    "e2e": "nx run at-app:playwright",
    "e2e:headless": "nx run at-app:playwright",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.1.7",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/localize": "22.1.7",
    "@angular/material": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@ngrx/effects": "22.0.1",
    "@ngrx/entity": "22.0.1",
    "@ngrx/router-store": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "ag-grid-angular": "36.2.0",
    "ag-grid-community": "36.2.0",
    "file-saver": "^2.0.5",
    "jquery": "^4.0.0",
    "jquery-min": "^0.0.2",
    "moment": "^2.31.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.0",
    "nx": "23.2.1",
    "nx-cloud": "19.1.3",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "uuid": "14.0.2",
    "vitest": "^4.0.8"
  }
}

{
  "name": "at-app",
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "ora": "5.3.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "npx nx serve at-app --configuration=development --live-reload",
    "startHalle": "nx serve -c halle --live-reload",
    "start-nx": "npx nx run at-app:build:halle",
    "build": "nx build",
    "build-halle": "npx nx run at-app:build:halle --skip-nx-cache",
    "build-halle-nx": "npx nx run at-app:build:halle --skip-nx-cache",
    "test": "nx test",
    "lint": "nx lint",
    "e2e": "nx e2e",
    "e2e:headless": "nx run at-app:cypress-run",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.12",
    "@angular/cdk": "21.2.12",
    "@angular/common": "21.2.12",
    "@angular/compiler": "21.2.12",
    "@angular/core": "21.2.12",
    "@angular/forms": "21.2.12",
    "@angular/localize": "21.2.12",
    "@angular/material": "21.2.12",
    "@angular/platform-browser": "21.2.12",
    "@angular/platform-browser-dynamic": "21.2.12",
    "@angular/router": "21.2.12",
    "@ngrx/effects": "21.1.0",
    "@ngrx/entity": "21.1.0",
    "@ngrx/router-store": "21.1.0",
    "@ngrx/store": "21.1.0",
    "@ngrx/store-devtools": "21.1.0",
    "ag-grid-angular": "^35.3.0",
    "ag-grid-community": "^35.3.0",
    "bootstrap": "^5.3.8",
    "file-saver": "^2.0.5",
    "jquery": "^4.0.0",
    "jquery-min": "^0.0.2",
    "moment": "^2.30.1",
    "rxjs": "^7.4.0",
    "tslib": "^2.5.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2102.12",
    "@angular-devkit/build-angular": "21.2.12",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "21.2.12",
    "@angular/cli": "21.2.12",
    "@angular/compiler-cli": "21.2.12",
    "@nx/angular": "22.7.4",
    "@nx/workspace": "22.7.4",
    "cypress": "^14.0.0",
    "eslint": "^9.0.0",
    "nx": "22.7.4",
    "nx-cloud": "19.1.3",
    "prettier": "^3.8.3",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.60.0",
    "uuid": "^14.0.0"
